# 石棺后端环境变量
# 复制为 .env 后修改

# 服务端口
PORT=3001

# JWT 密钥（生产环境务必修改为随机字符串）
JWT_SECRET=arkoverseer-secret-change-in-production

# 域名
DOMAIN=sarcophagus.org.cn

# /BEFORETHESARCOPHAGUS 页面密钥摘要（源码/示例不保留明文；生产环境可改为自己的 sha256 摘要）
BEFORE_SARCOPHAGUS_KEY_HASH=7a6e720976a598e1f8db18b3d690166a0bb27cbe32f6d4545e3afe09f2634c75
# 验证成功后播放的音频路径（可选，默认 /BEFORETHESARCOPHAGUS/telescope.mp3）
# BEFORE_SARCOPHAGUS_AUDIO_URL=/BEFORETHESARCOPHAGUS/telescope.mp3
